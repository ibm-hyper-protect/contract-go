{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright (c) 2026 IBM Corp. All rights reserved. SPDX-License-Identifier: Apache-2.0. Retrievable-secret contract fields: https://www.ibm.com/docs/en/ccrv/1.1.x?topic=solutions-retrievable-secret",
  "type": "object",
  "properties": {
    "env": {
      "type": "object",
      "properties": {
        "uv-secrets": {
          "$ref": "#/$defs/uvSecrets"
        },
        "host-attestation": {
          "$ref": "#/$defs/hostAttestation"
        }
      },
      "if": {
        "required": [
          "uv-secrets"
        ]
      },
      "then": {
        "required": [
          "host-attestation"
        ]
      }
    }
  },
  "$defs": {
    "uvSecrets": {
      "type": "object",
      "properties": {
        "lock": {
          "type": "boolean",
          "default": true
        }
      },
      "patternProperties": {
        "^index-[1-8]$": {
          "$ref": "#/$defs/uvSecret"
        }
      },
      "required": [
        "index-1"
      ],
      "dependentRequired": {
        "index-2": [
          "index-1"
        ],
        "index-3": [
          "index-2"
        ],
        "index-4": [
          "index-3"
        ],
        "index-5": [
          "index-4"
        ],
        "index-6": [
          "index-5"
        ],
        "index-7": [
          "index-6"
        ],
        "index-8": [
          "index-7"
        ]
      },
      "additionalProperties": false
    },
    "uvSecret": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pvsecret"
        },
        "pvsecret": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        },
        "pvsecret-crt": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        }
      },
      "required": [
        "type",
        "pvsecret"
      ],
      "additionalProperties": false
    },
    "hostAttestation": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^HKD-[0-9]{4}-[A-Z0-9]+$": {
          "$ref": "#/$defs/hostKeyDocument"
        }
      },
      "additionalProperties": false
    },
    "hostKeyDocument": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "host-key-doc": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        }
      },
      "required": [
        "description",
        "host-key-doc"
      ],
      "additionalProperties": false
    }
  }
}
